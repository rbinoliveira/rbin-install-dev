          "namespace": { "color": "#acafff" },
          "label": { "color": "#54b9ff" },
          "embedded": { "color": "#eef0f9" },
          "title": { "color": "#00daef", "font_weight": 700 },
          "link_uri": { "color": "#54b9ff" },
          "link_text": { "color": "#00daef" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 }
        }
