{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Houston",
  "author": "Ported from astro-build.houston (VS Code)",
  "themes": [
    {
      "name": "Houston",
      "appearance": "dark",
      "style": {
        "background": "#17191e",
        "surface.background": "#23262d",
