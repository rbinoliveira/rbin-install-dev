        "editor.line_number": "#545864",
        "editor.active_line_number": "#858b98",
        "editor.wrap_guide": "#343841",
        "editor.active_wrap_guide": "#343841",
        "editor.indent_guide": "#2a2d34",
        "editor.indent_guide_active": "#545864",
        "editor.document_highlight.read_background": "#ad5dca22",
        "search.match_background": "#ad5dca55",
        "terminal.background": "#17191e",
        "terminal.foreground": "#eef0f9",
        "terminal.ansi.black": "#17191e",
        "terminal.ansi.red": "#dc3657",
        "terminal.ansi.green": "#23d18b",
        "terminal.ansi.yellow": "#ffc368",
        "terminal.ansi.blue": "#2b7eca",
        "terminal.ansi.magenta": "#ad5dca",
        "terminal.ansi.cyan": "#24c0cf",
        "terminal.ansi.white": "#eef0f9",
        "created": "#4bf3c8",
        "created.background": "#4bf3c822",
        "modified": "#ffd493",
        "modified.background": "#ffd49322",
        "deleted": "#f4587e",
        "deleted.background": "#f4587e22",
        "conflict": "#ffc368",
        "error": "#f4587e",
        "warning": "#ffd493",
        "info": "#54b9ff",
        "hint": "#858b98",
        "success": "#4bf3c8",
        "ignored": "#545864",
        "hidden": "#545864",
        "players": [
          { "cursor": "#aeafad", "background": "#aeafad", "selection": "#ad5dca44" }
        ],
        "syntax": {
          "comment": { "color": "#eef0f98f", "font_style": "italic" },
