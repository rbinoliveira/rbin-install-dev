          "string": { "color": "#ffd493" },
          "string.escape": { "color": "#4bf3c8" },
          "string.regex": { "color": "#4bf3c8" },
          "number": { "color": "#ffd493" },
          "boolean": { "color": "#acafff" },
          "constant": { "color": "#acafff" },
          "function": { "color": "#00daef" },
          "type": { "color": "#acafff" },
          "constructor": { "color": "#acafff" },
          "variable": { "color": "#4bf3c8" },
          "variable.special": { "color": "#acafff" },
          "property": { "color": "#4bf3c8" },
          "attribute": { "color": "#4bf3c8" },
