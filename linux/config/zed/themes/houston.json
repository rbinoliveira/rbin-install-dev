        "tab.inactive_background": "#23262d",
        "status_bar.background": "#17548b",
        "border": "#343841",
        "border.variant": "#17191e",
        "border.focused": "#00daef",
        "border.selected": "#2d4860",
        "border.disabled": "#343841",
        "element.background": "#23262d",
        "element.hover": "#343841",
        "element.active": "#2d4860",
